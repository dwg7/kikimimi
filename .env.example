# Copy to .env (git-ignored) and fill in real values.
# See documents/decisions/0009-rpi-os-trixie-cloudinit-just.md for why these
# stay out of the repo (kaga0's docs/decisions/0007-secrets-policy.md).

# Hostname of the RPi 4B running RTL-SDR capture + whisper.cpp (without .local)
KIKIMIMI_RPI_HOST=

# SSH user on the RPi (Raspberry Pi OS Trixie's cloud-init default user, or whatever cloud-init's user-data creates)
KIKIMIMI_RPI_USER=

# Path to the SSH public key to bake into the RPi image via cloud-init
SSH_PUBKEY_FILE=~/.ssh/id_ed25519.pub

# Mac mini role machine's LLM endpoint (ollama, OpenAI-compatible API --
# see documents/decisions/0015-llm-endpoint-and-real-data-pipeline.md)
KIKIMIMI_LLM_URL=http://127.0.0.1:11434/v1
KIKIMIMI_LLM_MODEL=qwen2.5:14b

# tmpfs directory on the RPi that `speechmap record --out` writes segments
# into. RAM-backed on purpose -- segments never touch the SD card. See
# documents/decisions/0012-rsync-pull-over-tmpfs.md
KIKIMIMI_RPI_AUDIO_DIR=/mnt/kikimimi-audio

# Where scripts/sync-segments.sh (run on the Mac mini role machine) rsyncs
# segments to, and where it writes transcripts
KIKIMIMI_LOCAL_AUDIO_DIR=~/kikimimi-audio
KIKIMIMI_TRANSCRIPT_DIR=~/kikimimi-transcripts

# whisper.cpp server endpoint on the Mac mini role machine (Metal backend)
KIKIMIMI_WHISPER_URL=http://127.0.0.1:30180/inference
KIKIMIMI_LANGUAGE=ja

# Station tuned by the RPi's continuous `speechmap record` (systemd service,
# scripts/install-record-service.sh). NHK-FM Hokkaido is provisional, not a
# final decision -- see CLAUDE.md 6節. Gain is antenna-siting-dependent and
# should be re-tuned (rtl_power sweep) whenever the antenna moves -- see
# documents/decisions/0009-rpi-os-trixie-cloudinit-just.md "ゲインの再最適化".
KIKIMIMI_FREQ=85.2M
KIKIMIMI_GAIN=33.8
KIKIMIMI_DEVICE=0
KIKIMIMI_LABEL=NHKFM
KIKIMIMI_SEGMENT_SEC=60
KIKIMIMI_RETENTION_HOURS=12
KIKIMIMI_MAX_GB=0.8
