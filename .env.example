# Copy to .env (git-ignored) and fill in real values.
# See documents/decisions/0009-rpi-os-trixie-cloudinit-just.md for why these
# stay out of the repo (kaga0's docs/decisions/0007-secrets-policy.md).

# Hostname of the RPi 4B running RTL-SDR capture + whisper.cpp (without .local)
KIKIMIMI_RPI_HOST=

# SSH user on the RPi (Raspberry Pi OS Trixie's cloud-init default user, or whatever cloud-init's user-data creates)
KIKIMIMI_RPI_USER=

# Path to the SSH public key to bake into the RPi image via cloud-init
SSH_PUBKEY_FILE=~/.ssh/id_ed25519.pub

# Mac mini's LLM endpoint, once set up (see scripts/setup-macmini.sh)
KIKIMIMI_LLM_URL=http://127.0.0.1:8080/v1
